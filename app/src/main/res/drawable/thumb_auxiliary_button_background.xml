<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF31594F" />
            <stroke android:width="2dp" android:color="#FF00DDA3" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF253235" />
            <stroke android:width="3dp" android:color="#FF00DDA3" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF253235" />
            <stroke android:width="1.5dp" android:color="#FF00DDA3" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
