<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bright emerald outer rim. -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF19C886" />
        </shape>
    </item>
    <!-- Thin graphite inset ring. -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#FF252B29" />
        </shape>
    </item>
    <!-- Emerald center. -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#FF19C886" />
        </shape>
    </item>
</layer-list>
