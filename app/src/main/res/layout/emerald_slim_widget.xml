<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center"
    android:baselineAligned="false" android:padding="4dp"
    android:background="@drawable/emerald_widget_background">
    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
        <ImageButton android:id="@+id/slim_power"
            android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center"
            android:background="@drawable/notification_remote_button" android:padding="12dp"
            android:scaleType="centerInside" android:src="@drawable/ic_notification_power"
            android:contentDescription="@string/quick_remote_power" />
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
        <ImageButton android:id="@+id/slim_play_pause"
            android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center"
            android:background="@drawable/notification_remote_button" android:padding="12dp"
            android:scaleType="centerInside" android:src="@drawable/ic_widget_play_pause"
            android:contentDescription="@string/remote_play_pause" />
    </FrameLayout>
    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
        <ImageButton android:id="@+id/slim_mute"
            android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center"
            android:background="@drawable/notification_remote_button" android:padding="12dp"
            android:scaleType="centerInside" android:src="@drawable/ic_notification_mute"
            android:contentDescription="@string/slim_mute_toggle" />
    </FrameLayout>
</LinearLayout>
