<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
    android:baselineAligned="false" android:padding="4dp" android:background="@drawable/emerald_widget_background">
<ImageButton android:id="@+id/slim_power" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:minWidth="0dp" android:minHeight="0dp" android:background="@android:color/transparent" android:padding="2dp"
        android:scaleType="centerInside" android:src="@drawable/remote_control_power"
        android:contentDescription="@string/quick_remote_power" />
<ImageButton android:id="@+id/slim_play_pause" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:minWidth="0dp" android:minHeight="0dp" android:background="@android:color/transparent" android:padding="2dp"
        android:scaleType="centerInside" android:src="@drawable/remote_control_play_pause"
        android:contentDescription="@string/remote_play_pause" />
<ImageButton android:id="@+id/slim_mute" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:minWidth="0dp" android:minHeight="0dp" android:background="@android:color/transparent" android:padding="2dp"
        android:scaleType="centerInside" android:src="@drawable/remote_control_mute"
        android:contentDescription="@string/slim_mute_toggle" />
</LinearLayout>
