<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/emerald_widget_background" android:padding="4dp">
    <TextView android:id="@+id/emerald_widget_title" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.6"
        android:gravity="center" android:text="@string/app_name" android:contentDescription="@string/emerald_widget_open"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp"
        android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:textColor="#FF19C886" />
    <include layout="@layout/notification_remote_expanded" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="3" />
</LinearLayout>
