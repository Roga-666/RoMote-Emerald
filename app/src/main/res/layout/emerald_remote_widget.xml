<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:background="@drawable/emerald_widget_background" android:padding="4dp">
    <TextView android:id="@+id/emerald_widget_title"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center" android:text="@string/app_name"
        android:contentDescription="@string/emerald_widget_open"
        android:textSize="16sp" android:textStyle="bold" android:textColor="#FF19C886" />
    <include layout="@layout/notification_remote_expanded" />
</LinearLayout>
