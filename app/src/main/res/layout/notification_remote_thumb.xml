<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="180dp" android:orientation="horizontal" android:baselineAligned="false" android:layoutDirection="ltr">
  <!-- Individual buttons fill the available left panel. Spacers are real non-command gaps. -->
  <LinearLayout android:id="@+id/thumb_auxiliary_grid" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="104" android:orientation="vertical" android:baselineAligned="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false">
      <ImageButton android:id="@+id/notification_volume_up" style="@style/ThumbAuxiliaryButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:src="@drawable/ic_notification_volume_up" android:contentDescription="@string/remote_volume_up" />
      <TextView android:layout_width="8dp" android:layout_height="1dp" android:importantForAccessibility="no" />
      <ImageButton android:id="@+id/notification_power" style="@style/ThumbAuxiliaryButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:src="@drawable/ic_notification_power" android:contentDescription="@string/quick_remote_power" />
    </LinearLayout>
    <TextView android:layout_width="1dp" android:layout_height="8dp" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false">
      <ImageButton android:id="@+id/notification_volume_down" style="@style/ThumbAuxiliaryButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:src="@drawable/ic_notification_volume_down" android:contentDescription="@string/remote_volume_down" />
      <TextView android:layout_width="8dp" android:layout_height="1dp" android:importantForAccessibility="no" />
      <ImageButton android:id="@+id/notification_home" style="@style/ThumbAuxiliaryButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:src="@drawable/ic_notification_home" android:contentDescription="@string/remote_home" />
    </LinearLayout>
    <TextView android:layout_width="1dp" android:layout_height="8dp" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false">
      <ImageButton android:id="@+id/notification_mute" style="@style/ThumbAuxiliaryButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:src="@drawable/ic_notification_mute" android:contentDescription="@string/quick_remote_mute" />
      <TextView android:layout_width="8dp" android:layout_height="1dp" android:importantForAccessibility="no" />
      <ImageButton android:id="@+id/notification_play_pause" style="@style/ThumbAuxiliaryButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:src="@drawable/ic_widget_play_pause" android:contentDescription="@string/quick_remote_play_pause" />
    </LinearLayout>
  </LinearLayout>
  <TextView android:layout_width="8dp" android:layout_height="1dp" android:importantForAccessibility="no" />
  <RelativeLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="168">
    <ImageView android:id="@+id/thumb_dpad_face" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true" android:adjustViewBounds="true" android:maxWidth="168dp" android:maxHeight="168dp" android:src="@drawable/thumb_remote_dpad" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:baselineAligned="false" android:layout_alignLeft="@id/thumb_dpad_face" android:layout_alignRight="@id/thumb_dpad_face" android:layout_alignTop="@id/thumb_dpad_face" android:layout_alignBottom="@id/thumb_dpad_face">
      <Button android:id="@+id/notification_up" style="@style/ThumbRemoteHitTarget" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="42" android:contentDescription="@string/quick_remote_up" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="60" android:orientation="horizontal" android:baselineAligned="false">
        <Button android:id="@+id/notification_left" style="@style/ThumbRemoteHitTarget" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="42" android:contentDescription="@string/quick_remote_left" />
        <Button android:id="@+id/notification_ok" style="@style/ThumbRemoteHitTarget" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="60" android:contentDescription="@string/quick_remote_ok" />
        <Button android:id="@+id/notification_right" style="@style/ThumbRemoteHitTarget" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="42" android:contentDescription="@string/quick_remote_right" />
      </LinearLayout>
      <Button android:id="@+id/notification_down" style="@style/ThumbRemoteHitTarget" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="42" android:contentDescription="@string/quick_remote_down" />
    </LinearLayout>
  </RelativeLayout>
</LinearLayout>
