<?xml version="1.0" encoding="utf-8"?>
<!-- Each row and column receives a share of the actual host bounds. No fixed-width D-pad. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="164dp"
    android:orientation="vertical" android:padding="4dp" android:baselineAligned="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false">
<ImageButton android:id="@+id/notification_volume_up" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:minWidth="0dp" android:minHeight="0dp" android:background="@android:color/transparent" android:padding="2dp"
        android:scaleType="centerInside" android:src="@drawable/remote_control_volume_up"
        android:contentDescription="@string/remote_volume_up" />
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:importantForAccessibility="no" />
<ImageButton android:id="@+id/notification_up" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:minWidth="0dp" android:minHeight="0dp" android:background="@android:color/transparent" android:padding="2dp"
        android:scaleType="centerInside" android:src="@drawable/remote_control_up"
        android:contentDescription="@string/quick_remote_up" />
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:importantForAccessibility="no" />
<ImageButton android:id="@+id/notification_power" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:minWidth="0dp" android:minHeight="0dp" android:background="@android:color/transparent" android:padding="2dp"
        android:scaleType="centerInside" android:src="@drawable/remote_control_power"
        android:contentDescription="@string/quick_remote_power" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false">
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:importantForAccessibility="no" />
<ImageButton android:id="@+id/notification_left" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:minWidth="0dp" android:minHeight="0dp" android:background="@android:color/transparent" android:padding="2dp"
        android:scaleType="centerInside" android:src="@drawable/remote_control_left"
        android:contentDescription="@string/quick_remote_left" />
<ImageButton android:id="@+id/notification_ok" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:minWidth="0dp" android:minHeight="0dp" android:background="@android:color/transparent" android:padding="2dp"
        android:scaleType="centerInside" android:src="@drawable/remote_control_ok"
        android:contentDescription="@string/quick_remote_ok" />
<ImageButton android:id="@+id/notification_right" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:minWidth="0dp" android:minHeight="0dp" android:background="@android:color/transparent" android:padding="2dp"
        android:scaleType="centerInside" android:src="@drawable/remote_control_right"
        android:contentDescription="@string/quick_remote_right" />
<ImageButton android:id="@+id/notification_home" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:minWidth="0dp" android:minHeight="0dp" android:background="@android:color/transparent" android:padding="2dp"
        android:scaleType="centerInside" android:src="@drawable/remote_control_home"
        android:contentDescription="@string/remote_home" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false">
<ImageButton android:id="@+id/notification_volume_down" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:minWidth="0dp" android:minHeight="0dp" android:background="@android:color/transparent" android:padding="2dp"
        android:scaleType="centerInside" android:src="@drawable/remote_control_volume_down"
        android:contentDescription="@string/remote_volume_down" />
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:importantForAccessibility="no" />
<ImageButton android:id="@+id/notification_down" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:minWidth="0dp" android:minHeight="0dp" android:background="@android:color/transparent" android:padding="2dp"
        android:scaleType="centerInside" android:src="@drawable/remote_control_down"
        android:contentDescription="@string/quick_remote_down" />
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:importantForAccessibility="no" />
<ImageButton android:id="@+id/notification_mute" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:minWidth="0dp" android:minHeight="0dp" android:background="@android:color/transparent" android:padding="2dp"
        android:scaleType="centerInside" android:src="@drawable/remote_control_mute"
        android:contentDescription="@string/quick_remote_mute" />
</LinearLayout>
</LinearLayout>
