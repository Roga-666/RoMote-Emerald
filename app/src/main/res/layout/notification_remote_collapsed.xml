<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/app_name"
        android:textColor="#FF202124"
        android:textSize="16sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/notification_mute_compact"
        android:layout_width="54dp"
        android:layout_height="40dp"
        android:background="@drawable/notification_aux_button"
        android:gravity="center"
        android:text="MUTE"
        android:textColor="#FF202124"
        android:textSize="11sp"
        android:textStyle="bold" />
    <Space android:layout_width="10dp" android:layout_height="1dp" />
    <TextView
        android:id="@+id/notification_power_compact"
        android:layout_width="54dp"
        android:layout_height="40dp"
        android:background="@drawable/notification_aux_button"
        android:gravity="center"
        android:text="POWER"
        android:textColor="#FF202124"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
