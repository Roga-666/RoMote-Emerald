<resources>
    <style name="ThumbRemoteHitTarget" parent="android:Widget.Button">
        <item name="android:background">@drawable/thumb_remote_touch_feedback</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="ThumbAuxiliaryButton" parent="android:Widget.ImageButton">
        <item name="android:background">@drawable/thumb_auxiliary_button_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">6dp</item>
        <item name="android:tint">#FF00DDA3</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
